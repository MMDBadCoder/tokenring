# ---------------------------------------------------------------------------
# TokenRing configuration
# Every value here has a sensible default; nothing is strictly required.
# Operational settings (balancing strategy, retries, timeouts) live in the UI
# under Settings, not here, so they can be changed without a restart.
# ---------------------------------------------------------------------------

# --- Network ---------------------------------------------------------------
# Interface and port the proxy + dashboard listen on.
TOKENRING_HOST=0.0.0.0
TOKENRING_PORT=4000

# Public URL of this proxy, used for the copy-paste snippets in the dashboard.
# Leave empty to derive it from the incoming request.
TOKENRING_PUBLIC_URL=

# --- Storage ---------------------------------------------------------------
# SQLite database file. The parent directory is created automatically.
TOKENRING_DATA_DIR=./data

# --- Secrets ---------------------------------------------------------------
# 32-byte key (hex or base64) used to encrypt upstream API keys at rest.
# If unset, one is generated on first boot and stored in TOKENRING_DATA_DIR/master.key.
TOKENRING_ENCRYPTION_KEY=

# Dashboard password. If unset, a random one is generated on first boot and
# printed to the console exactly once.
TOKENRING_ADMIN_PASSWORD=

# How long a dashboard login stays valid.
TOKENRING_SESSION_TTL_HOURS=168

# --- Default upstream ------------------------------------------------------
# Seeds the first provider on an empty database. Afterwards, providers are
# managed in the dashboard under Settings -> Providers.
TOKENRING_DEFAULT_PROVIDER_NAME=Default
TOKENRING_DEFAULT_PROVIDER_BASE_URL=https://api.openai.com/v1

# --- Logging ---------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
TOKENRING_LOG_LEVEL=info

# Set to 1 to trust X-Forwarded-For (only behind a reverse proxy you control).
TOKENRING_TRUST_PROXY=0
